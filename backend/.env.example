# Sentinel Environment Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development

# Security
JWT_SECRET=sentinel_jwt_secret_change_in_production_key_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Credentials (Optional - platform falls back gracefully to deterministic analysis if empty)
GEMINI_API_KEY=

# Bitcoin Ingestion API (Public Blockstream Esplora endpoint)
BITCOIN_API_URL=https://blockstream.info/api

# Database Path (SQLite3 local file)
DATABASE_PATH=backend/data/sentinel.db

# Demo / Offline mode
DEMO_MODE=true
